# Copy to apps/server/.env and fill in locally.
# Never put real keys in the frontend or in git.

DATABASE_URL="file:D:/Projects/English-Listening-Lab/data/lab.db"

# OpenAI-compatible chat completions. Leave blank to use the offline lesson bank.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Optional. OpenAI-style POST {base}/audio/speech.
# If empty, the app uses the browser Speech Synthesis API and says so.
TTS_API_KEY=
TTS_BASE_URL=
TTS_MODEL=tts-1
TTS_VOICE=alloy

PORT=8787
# IANA calendar for new study days. Unset means Asia/Shanghai.
# An invalid value is rejected and does not fall back to the server timezone.
STUDY_TIMEZONE=Asia/Shanghai
# Daily cap for the single-user server. The isolated runtime uses the variables below.
AI_DAILY_LIMIT=12
# Suggested isolated request caps. They are not a confirmed money budget.
# AI_USER_DAILY_LIMIT=200
# AI_SITE_DAILY_LIMIT=1500
# AI_MAX_INPUT_TOKENS=8000
# AI_MAX_OUTPUT_TOKENS=6000
# AI_MAX_CONCURRENT=4
# AI_SITE_MAX_CONCURRENT=20
# Leave the next values empty until a spend limit is explicitly confirmed.
# AI_USER_DAILY_BUDGET_MICROS=
# AI_SITE_DAILY_BUDGET_MICROS=
# AI_HARD_BUDGET_MICROS=
# AI_PRICE_VERSION=
# AI_INPUT_MICROS_PER_MILLION=
# AI_OUTPUT_MICROS_PER_MILLION=

# Multi-user DeepSeek course generation. Enable real calls only in the intended environment.
AI_REAL_CALLS=0
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Multi-user online speech. Browser speech is available independently.
# The default prefers the existing DeepSeek key. TTS_VOICE accepts stella or tide.
# Set ONLINE_TTS_PROVIDER=openai to use the existing OpenAI fallback key.
ONLINE_TTS_ENABLED=0
ONLINE_TTS_PROVIDER=
ONLINE_TTS_API_KEY=

# Optional Resend email. Use a sender on a verified domain.
AUTH_MAIL_API_KEY=
AUTH_MAIL_FROM=
