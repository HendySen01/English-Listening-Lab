{
  "name": "@lab/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "db:push": "prisma db push",
    "auth:generate": "prisma generate --schema prisma-auth/schema.prisma",
    "user:generate": "node scripts/user/generate.mjs",
    "user-runtime": "tsx src/userRuntime.ts",
    "postinstall": "prisma generate && prisma generate --schema prisma-auth/schema.prisma && node scripts/user/generate.mjs",
    "test": "tsx src/selftest.ts && tsx src/authSelftest.ts && tsx src/userDrillSelftest.ts && tsx src/userRuntimeSelftest.ts && tsx src/userApiSelftest.ts && tsx src/userReviewSelftest.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "better-auth": "1.7.27",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "ts-fsrs": "5.3.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "prisma": "^6.19.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
