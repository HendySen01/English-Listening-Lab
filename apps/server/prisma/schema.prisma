generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model UserSettings {
  id                     Int      @id @default(1)
  dailyNewWords          Int      @default(6)
  difficulty             String   @default("A2+")
  listeningLevel         String   @default("match")
  dailyMinutes           Int      @default(60)
  theme                  String   @default("Daily Life")
  customTheme            String   @default("")
  autoGenerate           Boolean  @default(true)
  ttsVoice               String   @default("en-US")
  speechRate             Float    @default(1)
  locale                 String   @default("zh-CN")
  colorMode              String   @default("system")
  wordPartsEnabled       Boolean  @default(true)
  recommendationsEnabled Boolean  @default(true)
  updatedAt              DateTime @updatedAt
}

model DailyLesson {
  id               String         @id @default(cuid())
  lessonDate       String         @unique
  theme            String
  difficulty       String
  newWordCount     Int
  estimatedMinutes Int
  source           String
  model            String?
  poolNote         String         @default("")
  progress         String
  listeningTitle   String
  listeningText    String
  listeningChunks  String
  listeningGloss   String
  createdAt        DateTime       @default(now())
  words            Vocabulary[]
  questions        QuizQuestion[]
  sessions         StudySession[]
}

model Vocabulary {
  id             String        @id @default(cuid())
  lemma          String
  pos            String
  ipa            String?
  ipaNote        String        @default("")
  stress         String?
  meaningZh      String
  definitionEn   String
  collocation    String
  example        String
  exampleZh      String
  morphology     String?
  difficulty     String
  theme          String
  knownAlready   Boolean       @default(false)
  exampleFlagged Boolean       @default(false)
  createdAt      DateTime      @default(now())
  lessonId       String?
  lesson         DailyLesson?  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  progress       WordProgress?
}

model WordProgress {
  id             String     @id @default(cuid())
  vocabularyId   String     @unique
  vocabulary     Vocabulary @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)
  due            DateTime
  stability      Float      @default(0)
  difficulty     Float      @default(0)
  elapsedDays    Int        @default(0)
  scheduledDays  Int        @default(0)
  learningSteps  Int        @default(0)
  reps           Int        @default(0)
  lapses         Int        @default(0)
  state          Int        @default(0)
  lastReview     DateTime?
  firstLearnedAt DateTime   @default(now())
  correctCount   Int        @default(0)
  incorrectCount Int        @default(0)
  familiarity    String     @default("new")
  recallAbility  String     @default("unset")
}

model QuizQuestion {
  id            String        @id @default(cuid())
  lessonId      String
  lesson        DailyLesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  sortOrder     Int
  kind          String
  prompt        String
  options       String
  answerIndex   Int
  explanationEn String
  explanationZh String
  simplerZh     String
  evidence      String
  whyWrong      String
  attempts      QuizAttempt[]
}

model QuizAttempt {
  id         String       @id @default(cuid())
  questionId String
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selected   Int
  correct    Boolean
  createdAt  DateTime     @default(now())
}

model StudySession {
  id        String       @id @default(cuid())
  lessonId  String?
  lesson    DailyLesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  module    String
  minutes   Int          @default(0)
  createdAt DateTime     @default(now())
}

model ReviewEvent {
  id              String   @id @default(cuid())
  vocabularyId    String
  mode            String
  rating          String
  dueBefore       DateTime
  dueAfter        DateTime
  changedSchedule Boolean  @default(false)
  createdAt       DateTime @default(now())
}

model AIUsageRecord {
  id               String   @id @default(cuid())
  kind             String
  model            String
  promptTokens     Int?
  completionTokens Int?
  success          Boolean
  error            String?
  createdAt        DateTime @default(now())
}
